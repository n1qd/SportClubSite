rules_version = '2';

// =============================================================================
//  HypeSportClub — Firestore Security Rules
//  Соответствует актуальной схеме данных:
//   • users            (CLIENT / TRAINER / ADMIN / MANAGER)
//   • subscriptions    (шаблоны абонементов, управляет MANAGER)
//   • user_subscriptions (выданные клиенту, выдаёт ADMIN)
//   • trainers         (карточки тренеров)
//   • group_workouts   (групповые + индивидуальные тренировки)
//   • trainer_availability (слоты доступности тренера на конкретные даты)
//   • training_requests (заявки клиентов на индивидуальную)
//   • chats            (плоская коллекция сообщений с полем chatId)
//   • food_entries     (дневник питания клиента)
//   • users/{uid}/nutritionHistory (история BMR-расчётов)
//   • expenses, revenues (финансы — MANAGER)
//   • reviews, notifications, app_settings
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      // Безопасно достаём роль: get() кидает ошибку если документ отсутствует,
      // поэтому предварительно проверяем существование документа.
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null)
        : null;
    }

    function isAdmin()   { return isAuthenticated() && getUserRole() == 'ADMIN'; }
    function isTrainer() { return isAuthenticated() && getUserRole() == 'TRAINER'; }
    function isClient()  { return isAuthenticated() && getUserRole() == 'CLIENT'; }
    function isManager() { return isAuthenticated() && getUserRole() == 'MANAGER'; }
    function isStaff()   { return isAdmin() || isTrainer() || isManager(); }

    // Изменение групповой тренировки клиентом — только список участников
    function isSignUpOrCancelUpdate() {
      let allowedFields = ['participantIds', 'currentParticipants'];
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }

    // ==================== ПОЛЬЗОВАТЕЛИ ====================
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin() || isTrainer() || isManager();
      allow create: if isOwner(userId) || isAdmin() || isManager();
      allow update: if isOwner(userId) || isAdmin() || isManager();
      allow delete: if isAdmin();

      // История BMR-расчётов клиента (заполняется Cloud Function calculateBMR)
      match /nutritionHistory/{entryId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // ==================== ШАБЛОНЫ АБОНЕМЕНТОВ ====================
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    // ==================== ВЫДАННЫЕ АБОНЕМЕНТЫ ====================
    match /user_subscriptions/{subId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      // Создаёт админ (выдача клиенту)
      allow create: if isAdmin();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== ТРЕНЕРЫ ====================
    match /trainers/{trainerId} {
      allow read:   if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTrainer() && resource.data.userId == request.auth.uid);
    }

    // ==================== ТРЕНИРОВКИ (групповые + индивидуальные) ====================
    match /group_workouts/{workoutId} {
      allow read: if isAuthenticated();
      // Создавать может персонал; клиент — только индивидуальную на себя
      allow create: if isStaff() ||
        (isClient() && request.resource.data.isIndividual == true &&
         request.resource.data.clientId == request.auth.uid);
      allow update: if isAdmin() ||
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        (isClient() && resource.data.clientId == request.auth.uid) ||
        (isClient() && isSignUpOrCancelUpdate());
      // Удалять — админ или клиент свою индивидуальную
      allow delete: if isAdmin() ||
        (isClient() && resource.data.isIndividual == true &&
         resource.data.clientId == request.auth.uid);
    }

    // ==================== ДОСТУПНОСТЬ ТРЕНЕРА (на конкретные даты) ====================
    // create: проверяем поле trainerId в request.resource (новый документ)
    // update/delete: проверяем resource.data (существующий)
    match /trainer_availability/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.trainerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());
    }

    // ==================== ЗАЯВКИ НА ТРЕНИРОВКУ ====================
    match /training_requests/{reqId} {
      allow read: if isAuthenticated() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.trainerId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() &&
        request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin() ||
         resource.data.clientId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }

    // ==================== ЧАТЫ (плоская коллекция сообщений) ====================
    // Каждый документ = одно сообщение, поле chatId связывает диалог.
    // chatId формируется конкатенацией двух uid через "_" в отсортированном порядке.
    match /chats/{messageId} {
      // Читать может любой авторизованный пользователь, чей uid есть в chatId
      // или участник может прочитать всё (фильтрация на клиенте)
      allow read: if isAuthenticated();
      // Отправляет только владелец senderId; chatId должен содержать его uid
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.chatId.matches('.*' + request.auth.uid + '.*');
      // Обновлять только поле isRead (отметка прочитанным собеседником)
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // ==================== ДНЕВНИК ПИТАНИЯ (БЖУ) ====================
    match /food_entries/{entryId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== ОТЗЫВЫ ====================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== УВЕДОМЛЕНИЯ ====================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isStaff();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== ФИНАНСЫ (только MANAGER + ADMIN) ====================
    match /expenses/{docId} {
      allow read, create, update, delete: if isAdmin() || isManager();
    }
    match /revenues/{docId} {
      allow read, create, update, delete: if isAdmin() || isManager();
    }

    // ==================== НАСТРОЙКИ ПРИЛОЖЕНИЯ ====================
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
