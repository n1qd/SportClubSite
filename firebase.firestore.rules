rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u != null && u.data != null ? u.data.get('role', null) : null;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'TRAINER';
    }

    function isClient() {
      return isAuthenticated() && getUserRole() == 'CLIENT';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'MANAGER';
    }

    function isStaff() {
      return isAdmin() || isTrainer() || isManager();
    }

    function isSignUpOrCancelUpdate() {
      let allowedFields = ['participantIds', 'currentParticipants'];
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return changedFields.hasOnly(allowedFields);
    }

    // ==================== ПОЛЬЗОВАТЕЛИ (users) ====================
    // Руководитель: чтение (персонал, статистика), добавление и редактирование сотрудников
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isTrainer() || isManager();
      allow create: if isOwner(userId) || isAdmin() || isManager();
      allow update: if isOwner(userId) || isAdmin() || isManager();
      allow delete: if isAdmin();

      // Подколлекция: история БЖУ
      match /nutritionHistory/{entryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // ==================== ШАБЛОНЫ АБОНЕМЕНТОВ (subscriptions) ====================
    // Руководитель: создание и редактирование видов абонементов. Администратор — только выдача клиентам.
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isManager();
      allow delete: if isAdmin();
    }

    // ==================== КУПЛЕННЫЕ АБОНЕМЕНТЫ (user_subscriptions) ====================
    // Добавлять абонемент клиенту может только администратор
    match /user_subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin() || isManager());
      allow create: if isAdmin();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== ТРЕНЕРЫ (trainers) ====================
    // Тренер может обновлять свой документ (фото, контакты и т.д.)
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTrainer() && resource.data.userId == request.auth.uid);
    }

    // ==================== ТРЕНИРОВКИ (group_workouts) ====================
    match /group_workouts/{workoutId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update: if isAdmin() ||
        (isTrainer() && resource.data.trainerId == request.auth.uid) ||
        (isClient() && resource.data.clientId == request.auth.uid) ||
        (isClient() && isSignUpOrCancelUpdate());
      allow delete: if isAdmin();
    }

    // ==================== ЗАПИСИ НА ТРЕНИРОВКИ ====================
    match /workout_registrations/{registrationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() &&
        (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isStaff());
    }

    // ==================== ОТЗЫВЫ (reviews) ====================
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== УВЕДОМЛЕНИЯ ====================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isStaff();
      allow update: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ==================== ПЛАТЕЖИ ====================
    match /payments/{paymentId} {
      allow read: if isAdmin() || isManager();
      allow write: if false;
    }

    // ==================== НАСТРОЙКИ ====================
    match /app_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==================== ДОСТУПНОСТЬ ТРЕНЕРА ====================
    // create: проверяем request.resource (новый документ); update/delete: resource (существующий)
    match /trainer_availability/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.resource.data.trainerId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());
    }

    // ==================== ЗАПРОСЫ НА ТРЕНИРОВКУ ====================
    match /training_requests/{reqId} {
      allow read: if isAuthenticated() &&
        (resource.data.clientId == request.auth.uid ||
         resource.data.trainerId == request.auth.uid || isStaff());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.trainerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ==================== ЧАТЫ ====================
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;

      match /messages/{msgId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }

    // ==================== РАСХОДЫ (руководитель) ====================
    match /expenses/{docId} {
      allow read: if isAdmin() || isManager();
      allow create: if isAdmin() || isManager();
      allow delete: if isAdmin() || isManager();
    }

    // ==================== ДОХОДЫ (руководитель) ====================
    match /revenues/{docId} {
      allow read: if isAdmin() || isManager();
      allow create: if isAdmin() || isManager();
      allow delete: if isAdmin() || isManager();
    }
  }
}
